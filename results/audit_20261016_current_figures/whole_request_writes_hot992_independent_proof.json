  "source_review": {
    "initial": "Frozen src/tiered_kv_cache.py initial_bifurcation selects up to int(cold_capacity*fraction) remaining prompt positions, clones selected cold K and V only. GPU hot clones, dropped prompt positions and metadata are excluded. Raw cold tensors have exact logical/backing bytes and no initial shadow rows.",
    "decode": "Each selected demotion increments demoted. A matching shadow increments writes_saved and avoids append_stt_pair. Nonmatching victims are appended as K/V payload. Thus decoder paid=demoted-saved counts logical newly appended payload rows, not all allocator or tensor-copy traffic.",
    "geometry": "One layer-token row means K plus V over eight KV heads,128 elements/head,two bytes/BF16:2*8*128*2=4096 bytes. Sum over32 layers; do not multiply layer totals by32 again."
  },
  "interpretation": {
    "legitimate_result": "The trace-based logical cold-payload accounting confirms write avoidance, including initial retained cold placement. The smaller whole-request percentage follows directly from adding actual initial cold placement to both measured and counterfactual counts.",
    "counterfactual": "Fixed measured inclusive-policy trace with every demotion charged. This is not an actual exclusive-policy run: different backup retention/capacity can alter victims, retrieval, generation and quality. No causal exclusive-policy superiority is established.",
    "denominator": "Whole-request here means only declared initial retained cold K/V placement plus logical decode-demotion payload writes; not all model prefill writes, cold metadata, compaction/reallocation copies, hardware transfers or physical device programming.",
    "simulation": "Raw cold payloads are GPU tensors in this simulation. No physical STT write, endurance, lifetime or energy benefit can be inferred from these counters.",
    "aggregation": "Pooled write fraction is workload/trace-volume weighted and strongly influenced by long GovReport generations. Equal-task macro and per-task values must accompany it for balanced task interpretation."
  }
